hybrid reachability
{
 state var g1, g2, d1, d2, t

 setting
 {
  fixed steps 0.1
  time 2
  remainder estimation 1e-5
  identity precondition
  gnuplot octagon t, g1
  fixed orders 5
  cutoff 1e-15
  precision 128
  output battery
  max jumps 1
  print on
 }

 modes
 {
  l11
  {
   poly ode 1
   {
    d1' = 1
    d2' = 1
    g1' = -0.3
    g2' = -0.3
    t'  = 1
   }

   inv
   {
    g1 >= 0.5
    g2 >= 0.5
   }
  }

  l12
  {
   poly ode 1
   {
    d1' = 0.8
    d2' = -0.166
    g1' = -0.5
    g2' = 0
    t'  = 1
   }

   inv
   {
    g1 >= 0.5
   }
  }

  l21
  {
   poly ode 1
   {
    d1' = -0.166
    d2' = 0.8
    g1' = 0
    g2' = -0.5
    t'  = 1
   }

   inv
   {
    g2 >= 0.5
   }
  }

  l31
  {
   poly ode 1
   {
    d1' = 0
    d2' = 0.7
    g1' = 0
    g2' = -7
    t'  = 1
   }

   inv
   {
    g1 <= 1
    g2 >= 0.5
   }
  }

  l13
  {
   poly ode 1
   {
    d1' = 0.7
    d2' = 0
    g1' = -7
    g2' = 0
    t'  = 1
   }

   inv
   {
    g1 >= 0.5
    g2 <= 1
   }
  }

  l33
  {
   poly ode 1
   {
    d1' = 0
    d2' = 0
    g1' = 0
    g2' = 0
    t'  = 1
   }
   inv
   {
   }
  }

 }
#################################################
#################################################
#################################################
 jumps
 {
  l11 -> l12
  guard { g1 >= 2 }
  reset { }
  
  l11 -> l31
  guard { g1 <= 1 }
  reset { }

  l11 -> l21
  guard { g2 >= 2 }
  reset { }

  l11 -> l13
  guard { g2 <= 1 }
  reset { }

  ####################################################

  l12 -> l21
  guard { g2 >= 2 }
  reset { }

  l12 -> l31
  guard { g1 <= 1 }
  reset { }

  ####################################################

  l21 -> l12
  guard { g1 >= 2 }
  reset { }

  l21 -> l13
  guard { g2 <= 1 }
  reset { }

  ####################################################

  l31 -> l33
  guard { g2 <= 1 }
  reset { }

  ####################################################

  l13 -> l33
  guard { g1 <= 1 }
  reset { }

 }

 init
 {
  l11
  {
   g1 >= 8.4
   g1 <= 8.5

   d1 >= 0
   d1 <= 0.1

   g2 >= 7.4
   g2 <= 7.5

   d2 >= 0
   d2 <= 0.1

   t in [0, 0]
  }
 }
}

