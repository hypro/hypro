hybrid reachability
{
 state var x,v

 setting
 {
  fixed steps 0.1
  time 2
  remainder estimation 1e-5
  identity precondition
  gnuplot octagon x,v
  fixed orders 5
  cutoff 1e-15
  precision 128
  output bouncing_ball
  max jumps 1
  print on
 }

 modes
 {
  l
  {
   poly ode 1
   {
    x' = 2 * v + 1
    v' = 1
   }

   inv
   {
   }
  }
  l'
  {
   poly ode 1
  {
    x' = 1
    v' = 0
   }

   inv
   {
   }
  }
 }

 jumps
 {
  l -> l'
  guard {  }
  reset {x' := x + 5 v' := v + 5}
 }

 init
 {
  l
  {
   x in [0, 0]
   v in [1, 2]
  }
 }
}

