hybrid reachability
{
 state var v, x

 setting
 {
  fixed steps 0.1
  time 3
  remainder estimation 1e-5
  identity precondition
  gnuplot octagon v,x
  fixed orders 5
  cutoff 1e-15
  precision 128
  output bouncing_ball
  max jumps 3
  print on
 }

 modes
 {
  l
  {
   poly ode 1
   {
    x' = v
    v' = -9.81
   }

   inv
   {
    x >= 0
   }
  }
 }

 jumps
 {
  l -> l
  guard { x = 0 v <= 0 }
  reset { v' := -0.75*v }
  parallelotope aggregation {}
 }

 init
 {
  l
  {
   x in [0, 0]
   v in [-14.2, -14]
  }
 }
}


unsafe set
{
  l
  {
   x in [2,4]
   v in [-2.5,0]
   
  }
}
